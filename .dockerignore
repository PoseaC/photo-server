# This file must sit at the build-context root (the project root), because
# Docker only reads .dockerignore from the context root.

# Dependencies and build output (regenerated inside the image)
node_modules
bin
build

# Version control and local config / secrets
.git
.gitignore
.env

# Docker files: keep compose/Dockerfile out of the build context, but the nginx
# template must remain available for the COPY in the Dockerfile.
docker/*
!docker/default.conf.template

# Project meta (not needed by the build)
build_command.txt
*.md
LICENSE

# Logs
npm-debug.log*
